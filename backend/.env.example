# Port the server listens on (Render/Railway set this automatically)
PORT=4000

# Allowed browser origins, comma-separated. Use * to allow any origin.
# Example: https://streamly-psi-six.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# TURN relay: needed for video calls across different networks (mobile data, strict routers).
# Option 1 (recommended, free tier): Cloudflare Realtime TURN key
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Option 2: any static TURN server (e.g. metered.ca)
# TURN_URL may be a comma-separated list.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
