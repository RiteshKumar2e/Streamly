# Port the server listens on (Render/Railway set this automatically)
PORT=4000

# Allowed browser origins, comma-separated. Use * to allow any origin.
# Example: https://streamly.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Optional TURN server (needed when peers are behind strict NATs).
# TURN_URL may be a comma-separated list.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
